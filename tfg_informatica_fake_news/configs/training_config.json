{
  "dataset_path": "data/labeled/fake_news_unified.csv.gz",
  "text_column": "normalized_text",
  "label_column": "label",
  "test_size": 0.25,
  "random_state": 42,
  "selection_metric": "macro_f1",
  "reports_dir": "reports/training_runs",
  "model_output_dir": "models/training_runs",
  "candidate_models": [
    {
      "name": "logistic_regression",
      "classifier": "logistic_regression",
      "tfidf": {
        "ngram_range": [
          1,
          2
        ],
        "min_df": 1,
        "max_features": 5000
      },
      "params": {
        "C": 1.0,
        "max_iter": 1000,
        "class_weight": "balanced"
      }
    },
    {
      "name": "linear_svc",
      "classifier": "linear_svc",
      "tfidf": {
        "ngram_range": [
          1,
          2
        ],
        "min_df": 1,
        "max_features": 5000
      },
      "params": {
        "C": 1.0,
        "class_weight": "balanced"
      }
    }
  ]
}
