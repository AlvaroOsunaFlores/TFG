{
  "id": null,
  "uid": "tfg-observability",
  "title": "TFG Observability - Telegram Phishing Pipeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["tfg", "telegram", "phishing", "prometheus"],
  "panels": [
    {
      "id": 1,
      "title": "Throughput actual (msg/s)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tfg_messages_processed_total{result=\"ok\"}[5m]))",
          "legendFormat": "ok msg/s"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "title": "Profundidad de cola",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "tfg_queue_depth_messages",
          "legendFormat": "queue depth"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "Latencia E2E p95 (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(tfg_pipeline_stage_latency_ms_bucket{stage=\"end_to_end\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "title": "Errores del worker (5m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tfg_messages_processed_total{result=\"error\"}[5m]))",
          "legendFormat": "errors/s"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "title": "Latencias por etapa",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(tfg_pipeline_stage_latency_ms_bucket{stage=\"preprocess\"}[5m])) by (le))",
          "legendFormat": "preprocess p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(tfg_pipeline_stage_latency_ms_bucket{stage=\"inference\"}[5m])) by (le))",
          "legendFormat": "inference p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum(rate(tfg_pipeline_stage_latency_ms_bucket{stage=\"db_write\"}[5m])) by (le))",
          "legendFormat": "db write p95"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(tfg_pipeline_stage_latency_ms_bucket{stage=\"end_to_end\"}[5m])) by (le))",
          "legendFormat": "e2e p95"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 6,
      "title": "Recursos del proceso",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "tfg_process_cpu_percent",
          "legendFormat": "cpu %"
        },
        {
          "refId": "B",
          "expr": "tfg_process_rss_bytes",
          "legendFormat": "rss bytes"
        },
        {
          "refId": "C",
          "expr": "tfg_process_vms_bytes",
          "legendFormat": "vms bytes"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 }
    },
    {
      "id": 7,
      "title": "Benchmark throughput por escenario",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "tfg_benchmark_throughput_mps",
          "legendFormat": "{{scenario}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 }
    },
    {
      "id": 8,
      "title": "Benchmark latencia p95 por escenario",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "tfg_prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "tfg_benchmark_latency_p95_ms",
          "legendFormat": "{{scenario}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 }
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
